<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floating App"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anti Terdeteksi"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS OVERLAY"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ Belum diizinkan"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Buka Pengaturan Izin"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KONTROL BUBBLE"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnTampilkan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Tampilkan"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnSembunyikan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Sembunyikan"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BENTUK BUBBLE"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rgShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbBulat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bulat"
                android:checked="true"
                android:textColor="#FFFFFF"
                android:buttonTint="#1565C0"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kotak"
                android:textColor="#FFFFFF"
                android:buttonTint="#1565C0"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbSegitiga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Segitiga"
                android:textColor="#FFFFFF"
                android:buttonTint="#1565C0"/>
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WARNA BUBBLE"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnColorBlue"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Biru"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnColorGreen"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Hijau"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnColorRed"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Merah"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
